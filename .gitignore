# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# 测试与覆盖率产物
test-results/
playwright-report/
coverage/
.vite/

# 本地 AI 工具状态。
# 只忽略这份本地文件而不是整个 .claude/，这样将来仍可提交共享的
# .claude/settings.json 或自定义 skills。
.claude/settings.local.json

# 环境变量。应用本身不读任何环境变量，但提前挡住这个入口，
# 避免日后接入需要密钥的功能时误提交。
.env
.env.*
!.env.example

# 杂项
*.log
.DS_Store
Thumbs.db
